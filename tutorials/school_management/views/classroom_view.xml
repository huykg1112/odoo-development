<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_classroom_form" model="ir.ui.view">
        <field name="name">classroom.form</field>
        <field name="model">student.classroom</field>
        <field name="arch" type="xml">
            <form string="Classroom">
                <sheet>
                    <group string="Thong tin co ban" name="basic_info">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="grade_level"/>
                        </group>
                        <group>
                            <field name="teacher_id"/>
                            <field name="capacity"/>
                            <field name="current_size" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Mo ta" name="description">
                        <field name="description" nolabel="1"/>
                    </group>

                    <group string="Hoc sinh" name="students" colspan="2">
                        <field name="student_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="code"/>
                                <field name="gender"/>
                                <field name="age"/>
                                <field name="phone"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_classroom_tree" model="ir.ui.view">
        <field name="name">classroom.tree</field>
        <field name="model">student.classroom</field>
        <field name="arch" type="xml">
            <list string="Classrooms">
                <field name="name"/>
                <field name="code"/>
                <field name="current_size"/>
                <field name="teacher_id"/>
            </list>
        </field>
    </record>

    <record id="action_classroom" model="ir.actions.act_window">
        <field name="name">Classrooms</field>
        <field name="res_model">student.classroom</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
